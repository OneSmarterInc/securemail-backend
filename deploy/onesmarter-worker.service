[Unit]
PartOf=onesmarter.target
Description=OneSmarter Secure Mail Celery worker
After=network-online.target onesmarter-keyservice.service
RequiresMountsFor=/var/www/securemail-backend /var/lib/onesmarter

[Service]
Type=exec
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/securemail-backend/current
EnvironmentFile=/etc/onesmarter/backend.env
Environment=DJANGO_READ_DOT_ENV=false
ExecStart=/var/www/securemail-backend/venv/bin/celery -A backend.config.celery worker --loglevel=INFO --concurrency=2
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/onesmarter
LimitCORE=0

[Install]
WantedBy=onesmarter.target
