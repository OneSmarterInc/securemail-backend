# Deployment configuration template, not release approval.
# APP_ENV=production requires the checks in PRODUCTION_STARTUP.md; security approval is separate.
APP_ENV=production
ENABLE_DEV_TOOLS=false
PUBLIC_URL=https://securemail.onesmarter.com
RECIPIENT_PUBLIC_URL=https://securemail.onesmarter.com/recipient
ALLOWED_HOSTS=securemailbackend.onesmarter.com
CSRF_TRUSTED_ORIGINS=https://securemail.onesmarter.com
CORS_ALLOWED_ORIGINS=https://securemail.onesmarter.com
COOKIE_SAMESITE=Lax
TRUSTED_PROXY_UNIX_SOCKET=true
# Baseline: persistent EBS volume mounted here on the application instance.
# Never use the container writable layer or ephemeral instance storage for retained files.
STORAGE_PROVIDER=local
APP_RUNTIME_DIR=/var/lib/onesmarter/runtime
# S3 is an optional alternative: set STORAGE_PROVIDER=s3, S3_BUCKET and AWS_REGION.
# Object encryption uses SSE-S3, never an AWS KMS dependency.
S3_BUCKET=
# Inject a strong DJANGO_SECRET_KEY and POSTGRES_PASSWORD through the deployment secret store.
# Confirmed AWS layout: PostgreSQL on the SAME EC2, native systemd services.
# Keep PostgreSQL bound to loopback and port 5432 closed in the security group.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=secure_mail
POSTGRES_USER=secure_mail_app
REDIS_URL=redis://127.0.0.1:6379/0
KEY_PROTECTOR=key-service
KEY_SERVICE_URL=https://keys.internal:8443
KEY_SERVICE_CA=/etc/onesmarter/pki/key-service-ca.pem
KEY_SERVICE_CERT=/etc/onesmarter/pki/workload.pem
KEY_SERVICE_KEY=/etc/onesmarter/pki/workload.key
ALLOW_LEGACY_SYNTHETIC_READS=false
PQ_TRANSPORT_REQUIRED=true
MAIL_PROVIDER=smtp
EMAIL_HOST=smtp.ionos.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Audit logs remain in the application PostgreSQL database; no external archive.
AWS_REGION=

# Exact operator-approved mailbox exceptions; account roles remain enforced.
COMPANY_EMAIL_ALLOWLIST=

# Independent integrity lookup secret; preserve across Django signing-key rotation.
DOCUMENT_INTEGRITY_KEY=
# Temporary legacy recovery-code compatibility during signing-key rotation.
RECOVERY_LEGACY_KEYS=
DJANGO_SECRET_KEY_FALLBACKS=

DJANGO_READ_DOT_ENV=false
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
SEARCH_INDEX_KEY=
KEY_SERVICE_CUSTODIAN_DIRECTORY=/var/lib/onesmarter-key/accounts
