[Unit]
Description=OneSmarter Secure Mail singleton scheduler
After=network-online.target
RequiresMountsFor=/var/lib/onesmarter

[Service]
User=onesmarter
Group=onesmarter
WorkingDirectory=/opt/onesmarter/current
EnvironmentFile=/etc/onesmarter/backend.env
Environment=DJANGO_READ_DOT_ENV=false
ExecStart=/opt/onesmarter/venv/bin/celery -A backend.config.celery beat --loglevel=INFO --schedule=/var/lib/onesmarter/celerybeat-schedule --pidfile=/var/lib/onesmarter/celerybeat.pid
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/onesmarter
LimitCORE=0

[Install]
WantedBy=multi-user.target
