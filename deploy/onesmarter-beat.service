[Unit]
PartOf=onesmarter.target
Description=OneSmarter Secure Mail singleton scheduler
After=network-online.target onesmarter-keyservice.service
RequiresMountsFor=/var/www/securemail-backend /var/lib/onesmarter

[Service]
Type=exec
User=onesmarter
Group=onesmarter
WorkingDirectory=/var/www/securemail-backend/current
EnvironmentFile=/etc/onesmarter/backend.env
Environment=DJANGO_READ_DOT_ENV=false
ExecStart=/var/www/securemail-backend/venv/bin/celery -A backend.config.celery beat --loglevel=INFO --schedule=/var/lib/onesmarter/runtime/celerybeat-schedule --pidfile=/var/lib/onesmarter/runtime/celerybeat.pid
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/onesmarter
LimitCORE=0

[Install]
WantedBy=onesmarter.target
