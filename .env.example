# Copy to .env in the repository root. Never commit .env.
# Existing process environment takes precedence. Empty secrets are placeholders.
# Required: missing/empty APP_ENV refuses startup. This profile is synthetic only.
APP_ENV=development
PUBLIC_URL=http://localhost:5173
RECIPIENT_PUBLIC_URL=http://localhost:5173/recipient
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_DEV_TOOLS=false
ENABLE_LEGACY_RECIPIENT_API=false
# Leave empty for direct Django access. Set 127.0.0.1 for the local Vite/nginx proxy.
TRUSTED_PROXY_IPS=
TRUSTED_PROXY_UNIX_SOCKET=false
# Empty uses the existing ignored .runtime/django.secret; do not replace casually.
DJANGO_SECRET_KEY=
# Empty host selects SQLite for native development. Compose supplies its DB host.
POSTGRES_HOST=
POSTGRES_DB=secure_mail
POSTGRES_USER=secure_mail
POSTGRES_PASSWORD=
REDIS_URL=redis://localhost:6379/0
STORAGE_PROVIDER=local
KEY_PROTECTOR=local-development
PQ_TRANSPORT_REQUIRED=false
KEY_SERVICE_URL=
KEY_SERVICE_CA=
KEY_SERVICE_CERT=
KEY_SERVICE_KEY=
KEY_SERVICE_REQUIRE_PQ=false
# Unapproved audit experiment. Key-service CLI reads its process environment.
KEY_SERVICE_AUDIT_CANDIDATE=false
KEY_SERVICE_CHECKPOINT_CONFIG=
# Public trust configuration only; never store private evidence signers here.
KEY_SERVICE_RECOVERY_TRUST=
# Optional candidate custodian copy-restore destination, disabled when empty.
KEY_SERVICE_CANDIDATE_RESTORE_DIR=
# Readiness uses local keys in synthetic local-development mode.
# Key-service mode requires the remote status endpoint/certificates.
KEY_STATUS_URL=
KEY_STATUS_CA=
KEY_STATUS_CERT=
KEY_STATUS_KEY=
KEY_STATUS_REQUIRE_PQ=false
# Never put unseal/recovery/root keys in an environment file.
# development captures mail locally. smtp sends real mail when a worker runs.
MAIL_PROVIDER=development
EMAIL_HOST=mail.privateemail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
DEFAULT_FROM_EMAIL=secure@example.test
# Local: private root .env. Deployment: inject through the process environment.
# Use a newly rotated password; never commit credentials. SMTP uses STARTTLS.
EMAIL_HOST_PASSWORD=
# Only the optional S3 document-storage adapter needs these; local storage does not.
AWS_REGION=
S3_BUCKET=

# Application delivery requires an exact company sender-to-credential mapping.
# Global EMAIL_HOST_* settings alone do not authorize application senders.
SMTP_SENDER_PROFILES_FILE=
SMTP_PASSWORD_NOTIFICATIONS=
SMTP_PASSWORD_STAFF=

SETUP_TOKEN_SHA256=
DEV_INBOX_TOKEN_SHA256=
STAGED_UPLOAD_QUOTA_BYTES=104857600

# Explicit company-mailbox exceptions; never a whole external domain.
COMPANY_EMAIL_ALLOWLIST=

# Evidence stays LOCAL on deployment unless an explicit migration is approved.
# EVIDENCE_DIRECTORY=/persistent/onesmarter/evidence
# Approved RFC 3161 TSA remains unset; no trusted timestamp is claimed.
EVIDENCE_TSA_URL=
EVIDENCE_TSA_CA_FILE=
EVIDENCE_OPENSSL=openssl

# Dedicated HMAC word-search secret. Required outside synthetic mode.
# Set privately; rotation requires manage.py rebuild_search_index during maintenance.
# SEARCH_INDEX_KEY=

# Audit batching and staff session policy (server-enforced).
STAFF_IDLE_SECONDS=900

# Generate once (init_local.py / init_compose.py); preserve across Django key rotation.
DOCUMENT_INTEGRITY_KEY=
# Transitional OLD Django keys only for pre-migration recovery codes; comma separated.
RECOVERY_LEGACY_KEYS=

# Temporary old signing keys for session/OTP/idempotency verification during rotation.
DJANGO_SECRET_KEY_FALLBACKS=
# Optional independently hosted partner integrations (server-only JSON).
# Supply real secrets via protected deployment environment, never frontend variables.
# See INTEGRATIONS.md; an empty map disables the service endpoint.
SECURE_MAIL_INTEGRATIONS={}

# Immediate best-effort Celery wakeup after database commit; beat remains fallback.
# Default: enabled outside SYNTHETIC_MODE. Requires a running worker and Redis.
# OUTBOX_IMMEDIATE_DISPATCH=1
# Numeric slow-request timing logs only; no content, SQL or credentials.
PERFORMANCE_TIMINGS=1
PERFORMANCE_LOG_THRESHOLD_MS=250

# Separate frontend HTTPS origin; exact origins only, no wildcard.
CORS_ALLOWED_ORIGINS=
COOKIE_SAMESITE=Lax

# Optional small-host cap: 5242880 (5 MiB); default remains 25 MiB.
MAX_UPLOAD_BYTES=26214400

# Separate SelfPay messages sent by Secure Mail. Enable after adding the real password.
SELFPAY_SMTP_ENABLED=false
SELFPAY_EMAIL_HOST=smtp.ionos.com
SELFPAY_EMAIL_PORT=587
SELFPAY_EMAIL_HOST_USER=patientcare@onesmarterhealthweb.com
SELFPAY_EMAIL_HOST_PASSWORD=
SELFPAY_EMAIL_USE_TLS=true
SELFPAY_EMAIL_USE_SSL=false
SELFPAY_FROM_EMAIL=patientcare@onesmarterhealthweb.com
